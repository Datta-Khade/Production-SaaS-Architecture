# App
NODE_ENV=development
PORT=5005
APP_URL=http://localhost:5005

# Database — Master
MASTER_DATABASE_URL=postgres://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/master_db

# Database — Single tenant (dev only)
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/tenant_db

# Auth
JWT_SECRET=1a42842d235153b27ed3e11769f08ac437731b990ac6a43349fe43ff548c2e0160982c4cfa9c6c623967ec75c40ec520
