# Local development environment
# This file is gitignored — never commit real secrets

###############################################################################
# ### BACKEND (Private) ###
# These variables are only accessible to the server (Node.js).
# DO NOT prefix these with VITE_ if they are secrets.
###############################################################################

# App
NODE_ENV=development
PORT=5005
APP_URL=http://localhost:5005

# Database — Master
MASTER_DATABASE_URL=postgres://postgres:sailadmin@localhost:5432/master_db

# Database — Single tenant (dev only)
DATABASE_URL=postgresql://postgres:sailadmin@localhost:5432/tenant_db

# Auth
JWT_SECRET=dev-jwt-secret-change-me-in-production-32chars
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-in-prod-32ch
REFRESH_TOKEN_EXPIRY=7d

# Redis
# REDIS_URL=redis://localhost:6379
REDIS_URL=''

# Feature Flags
AUTH_BYPASS=false
MULTI_TENANT=true

# Logging
# Options: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Set to true for human-readable console output
LOG_PRETTY=true
# Set to true to log every API request (e.g., "GET /api/v2/... 200")
LOG_HTTP_REQUESTS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@localhost

# Encryption — AES-256-GCM (64 hex chars). CHANGE IN PRODUCTION.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2

###############################################################################
# ### FRONTEND (Public) ###
# These variables are exposed to the browser.
# They MUST be prefixed with VITE_ to be picked up by Vite.
# NEVER store secrets here.
###############################################################################

# Secure Storage Key
VITE_STORAGE_KEY='sailAdmin'

