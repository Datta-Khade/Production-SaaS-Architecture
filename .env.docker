# Docker environment configuration
# Derived from .env.development

# App
NODE_ENV=production
PORT=3009
APP_URL=http://localhost

# Database — Master (Internal Docker Network)
MASTER_DATABASE_URL=postgres://postgres:sailadmin@postgres:5432/master_db

# Database — Single tenant (dev only, Internal Docker Network)
DATABASE_URL=postgresql://postgres:sailadmin@postgres:5432/tenant_db

# Auth
JWT_SECRET=dev-jwt-secret-change-me-in-production-32chars
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-in-prod-32ch
REFRESH_TOKEN_EXPIRY=7d

# Redis (Internal Docker Network)
REDIS_URL=redis://redis:6379

# Feature Flags
AUTH_BYPASS=false
MULTI_TENANT=true

# Logging
LOG_LEVEL=info
LOG_PRETTY=false
LOG_HTTP_REQUESTS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Email (Mailtrap)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=f459b5f5f623c1
SMTP_PASS=82b441e2a8b330
EMAIL_FROM=support@myapp.com

# Encryption — AES-256-GCM
ENCRYPTION_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2

# Frontend (Exposed to browser)
