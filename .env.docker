# Docker environment configuration
# This file is gitignored — NEVER commit real secrets.
# Copy from .env.example and fill in production values before deploying.

# App
NODE_ENV=production
PORT=3009
APP_URL=http://localhost

# Database — Master (Internal Docker Network)
MASTER_DATABASE_URL=postgres://postgres:CHANGE_ME_DB_PASSWORD@postgres:5432/master_db

# Database — Single tenant (dev only, Internal Docker Network)
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@postgres:5432/tenant_db

# Auth
JWT_SECRET=1a42842d235153b27ed3e11769f08ac437731b990ac6a43349fe43ff548c2e0160982c4cfa9c6c623967ec75c40ec520
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=776188af458feee36076cdeeb1cfa188cdec0b6de276f293ae5af79789de65dc50c475dd450ab3135d9ecbd45cac55f4
REFRESH_TOKEN_EXPIRY=7d

# Redis (Internal Docker Network)
REDIS_URL=redis://redis:6379

# Feature Flags
AUTH_BYPASS=false
MULTI_TENANT=true

# Logging
LOG_LEVEL=info
LOG_PRETTY=false
LOG_HTTP_REQUESTS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Email — replace with your real SMTP provider credentials
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
EMAIL_FROM=noreply@yourdomain.com

# Encryption — AES-256-GCM (64 hex chars)
ENCRYPTION_KEY=87ac40b89ea158c19e67efcdf6dee0aa98cd94e30c77f0a0ea6e16fa11a8d5e4

# Frontend (Exposed to browser)
VITE_STORAGE_KEY=fc92f5b024d5403a13aaefca6687465bad66147a6c418c1e

# AG Grid Enterprise License — obtain from https://www.ag-grid.com/
VITE_AG_GRID_LICENSE_KEY=CHANGE_ME_AG_GRID_LICENSE_KEY
