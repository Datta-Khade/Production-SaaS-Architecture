# Local development environment
# This file is gitignored — never commit real secrets

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database — Master
MASTER_DATABASE_URL=postgres://postgres:sailadmin@localhost:5432/Test_Master

# Database — Single tenant (dev only)
DATABASE_URL=postgres://postgres:sailadmin@localhost:5432/Test_Tenant_db

# Auth
JWT_SECRET=dev-jwt-secret-change-me-in-production-32chars
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-in-prod-32ch
REFRESH_TOKEN_EXPIRY=7d

# Redis
REDIS_URL=redis://localhost:6379

# Feature Flags
AUTH_BYPASS=false
MULTI_TENANT=false

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@localhost

# Encryption — AES-256-GCM (64 hex chars). CHANGE IN PRODUCTION.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2

