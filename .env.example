# Example environment variables
# Copy this file to .env.development and fill in your values

###############################################################################
# ### BACKEND (Private) ###
# These variables are only accessible to the server (Node.js).
###############################################################################

# App
NODE_ENV=development
PORT=3009
APP_URL=http://localhost:3009

# Database — Master
MASTER_DATABASE_URL=postgres://postgres:password@localhost:5432/master_db

# Database — Single tenant (dev only)
DATABASE_URL=postgres://postgres:password@localhost:5432/tenant_db

# Auth
JWT_SECRET=your-32-character-jwt-secret-here
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=your-32-character-refresh-secret-here
REFRESH_TOKEN_EXPIRY=7d

# Redis
REDIS_URL=redis://localhost:6379

# Feature Flags
AUTH_BYPASS=false
MULTI_TENANT=true

# Logging
# Options: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Set to true for human-readable console output false to detailed JSON output
LOG_PRETTY=true
# Set to true to log every API request (e.g., "GET /api/v2/... 200")
LOG_HTTP_REQUESTS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# Encryption — AES-256-GCM (64 hex chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2

###############################################################################
# ### FRONTEND (Public) ###
# These variables are exposed to the browser.
# They MUST be prefixed with VITE_ to be picked up by Vite.
###############################################################################

# Secure Storage Key
VITE_STORAGE_KEY=your-client-side-storage-key

# AG Grid Enterprise License
VITE_AG_GRID_LICENSE_KEY=your-ag-grid-license-key
